# Copy to .env (chmod 600) and fill in real values. Never commit .env.
# systemd loads this file with EnvironmentFile=; for manual runs use
#   python3 -m lookout --env-file .env ...
# Quote the values: Kuma's push URL contains "&".
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/CHANGE_ME/CHANGE_ME"
KUMA_PUSH_URL="http://localhost:3001/api/push/CHANGE_ME?status=up&msg=OK&ping="
