# Lookout: one read-only run. Started hourly by lookout.timer; never enabled on its own.
# Installed by deploy/install.sh into /etc/systemd/system/.
[Unit]
Description=Lookout hourly ops summary (read-only)
Documentation=https://github.com/DinethPerera-IT
Wants=network-online.target
After=network-online.target docker.service ollama.service

[Service]
Type=oneshot
User=lookout
Group=lookout
# Read the whole journal (read-only). This is why log lines are redacted on entry.
SupplementaryGroups=systemd-journal

# Code is a root-owned copy in /opt/lookout; the service can't modify it.
WorkingDirectory=/opt/lookout
Environment=PYTHONDONTWRITEBYTECODE=1
# Secrets: read by systemd (as root) before the sandbox starts, so the lookout user
# never needs access to /home. Holds DISCORD_WEBHOOK_URL, KUMA_PUSH_URL and,
# optionally, DISCORD_SHADOW_WEBHOOK_URL.
# The path below is filled in by deploy/install.sh (default: <repo>/.env; override with LOOKOUT_ENV_FILE=...)
EnvironmentFile=@ENV_FILE@
# SHADOW MODE: remove --shadow to go live (after the 2-week review in ROADMAP.md).
ExecStart=/usr/bin/python3 -m lookout --shadow

# Its only writable place: /var/lib/lookout (state.sqlite). Sets $STATE_DIRECTORY.
StateDirectory=lookout
StateDirectoryMode=0700
UMask=0077

# One run takes 1-2 minutes (the CPU-only LLM is most of it). A hung run is killed.
TimeoutStartSec=15min
Nice=10
IOSchedulingClass=idle
MemoryMax=768M

# --- Sandboxing: enforced by the kernel, not by trusting Lookout's code ---
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
# Unix sockets (systemctl, journal) and TCP/IP (localhost services + Discord). Nothing else.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
