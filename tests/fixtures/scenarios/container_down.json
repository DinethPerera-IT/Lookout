    {"minutes": 300, "facts": {"docker": {"ok": true, "by_source": {}, "error_templates": {}, "containers": [
       {"name": "clever_swirles", "id": "7f1e2d3c4b5a", "image": "busybox", "state": "exited", "status": "Exited (1) 3 months ago", "health": "none"}]}},
     "expect": {"report": {"container_gone:commoncents": "new"}, "resolved": ["container_restarting:commoncents"]}}
  ]
