{
  "description": "Only 10 hours of history: spike detection uses the conservative fixed threshold (20) instead of median + MAD.",
  "baseline": {"hours": 10, "templates": [["app.service", "request failed: timeout"]]},
  "runs": [
    {"minutes": 0, "facts": {"journal": {"ok": true,
       "by_source": {"app.service": {"total": 20, "errors": 12, "noise": 0}},
       "error_templates": {"app.service": {"request failed: timeout": {"count": 12, "examples": ["request failed: timeout"]}}}}},
     "expect": {}},
    {"minutes": 60, "facts": {"journal": {"ok": true,
       "by_source": {"app.service": {"total": 40, "errors": 25, "noise": 0}},
       "error_templates": {"app.service": {"request failed: timeout": {"count": 25, "examples": ["request failed: timeout"]}}}}},
     "expect": {"report": {"error_spike:app.service": "new"}}}
  ]
}
