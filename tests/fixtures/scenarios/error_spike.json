{
  "description": "cloudflared normally logs about 1 error an hour. A burst is flagged; a bigger burst escalates; a smaller repeat inside the 6 h cooldown stays quiet; after the cooldown it is reported again.",
  "baseline": {"hours": 168, "error_counts": {"cloudflared.service": [1, 0, 2, 1, 0, 1, 1, 0, 1, 2, 1, 0]},
               "templates": [["cloudflared.service", "failed to connect to edge <ip>"]]},
  "runs": [
    {"minutes": 0, "facts": {"journal": {"ok": true,
       "by_source": {"cloudflared.service": {"total": 40, "errors": 12, "noise": 0}},
       "error_templates": {"cloudflared.service": {"failed to connect to edge <ip>":
         {"count": 12, "examples": ["failed to connect to edge 198.41.200.13:7844"]}}}}},
     "expect": {"report": {"error_spike:cloudflared.service": "new"}}},
    {"minutes": 60, "facts": {"journal": {"ok": true,
       "by_source": {"cloudflared.service": {"total": 90, "errors": 30, "noise": 0}},
       "error_templates": {"cloudflared.service": {"failed to connect to edge <ip>":
         {"count": 30, "examples": ["failed to connect to edge 198.41.200.13:7844"]}}}}},
     "expect": {"report": {"error_spike:cloudflared.service": "worse"}}},
    {"minutes": 120, "facts": {"journal": {"ok": true,
       "by_source": {"cloudflared.service": {"total": 10, "errors": 0, "noise": 0}}, "error_templates": {}}},
     "expect": {}},
    {"minutes": 180, "facts": {"journal": {"ok": true,
       "by_source": {"cloudflared.service": {"total": 30, "errors": 8, "noise": 0}},
       "error_templates": {"cloudflared.service": {"failed to connect to edge <ip>":
         {"count": 8, "examples": ["failed to connect to edge 198.41.200.13:7844"]}}}}},
     "expect": {"suppressed": ["error_spike:cloudflared.service"]}},
    {"minutes": 480, "facts": {"journal": {"ok": true,
       "by_source": {"cloudflared.service": {"total": 30, "errors": 8, "noise": 0}},
       "error_templates": {"cloudflared.service": {"failed to connect to edge <ip>":
         {"count": 8, "examples": ["failed to connect to edge 198.41.200.13:7844"]}}}}},
     "expect": {"report": {"error_spike:cloudflared.service": "reminder"}}}
  ]
}
