         {"name": "grafana", "id": "8a9e6c5ae1f2", "image": "grafana/grafana", "state": "running", "status": "Up 9 minutes", "health": "none"},
         {"name": "uptime-kuma", "id": "6c80ad3ed2d6", "image": "louislam/uptime-kuma", "state": "running", "status": "Up 9 minutes (healthy)", "health": "healthy"}]}},
