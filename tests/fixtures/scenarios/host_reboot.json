       "docker": {"ok": true, "by_source": {}, "error_templates": {}, "containers": [
         {"name": "grafana", "id": "8a9e6c5ae1f2", "image": "grafana/grafana", "state": "running", "status": "Up About an hour", "health": "none"},
         {"name": "uptime-kuma", "id": "6c80ad3ed2d6", "image": "louislam/uptime-kuma", "state": "running", "status": "Up About an hour (healthy)", "health": "healthy"}]}},
     "expect": {}}
  ]
}
