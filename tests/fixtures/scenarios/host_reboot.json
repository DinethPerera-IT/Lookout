{
  "description": "The server reboots between checks (boot_time 1800003000 = 50 min after the first run). One host_reboot flag; the containers' short uptimes are not reported as 12 separate restarts.",
  "runs": [
    {"minutes": 0, "facts": {
       "host": {"ok": true, "boot_time": 1790000000},
       "docker": {"ok": true, "by_source": {}, "error_templates": {}, "containers": [
         {"name": "grafana", "id": "8a9e6c5ae1f2", "image": "grafana/grafana", "state": "running", "status": "Up 13 days", "health": "none"},
         {"name": "uptime-kuma", "id": "6c80ad3ed2d6", "image": "louislam/uptime-kuma", "state": "running", "status": "Up 13 days (healthy)", "health": "healthy"}]}},
     "expect": {}},
